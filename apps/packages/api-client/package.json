{
  "name": "@hospitalityos/api-client",
  "private": true,
  "description": "The typed HospitalityOS API client, generated from openapi.json (the API's committed contract).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json --output src/schema.d.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
