{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bindings": {
    "IdGenerator": {
      "Default": { "Adapter": "GuidV7" }
    },
    "EventTransport": {
      "Default": { "Adapter": "InMemory" }
    },
    "SearchIndex": {
      "Default": { "Adapter": "InMemory" }
    },
    "VectorStore": {
      "Default": { "Adapter": "InMemory" }
    }
  },
  "Persistence": {
    "Provider": "InMemory"
  },
  "Inference": {
    "Providers": {
      "fake": { "Adapter": "Fake" },
      "anthropic": { "Adapter": "Anthropic", "Settings": { "ApiKeyVariable": "ANTHROPIC_API_KEY" } }
    },
    "Tasks": {
      "content.embed": { "Provider": "fake", "Model": "fake-embedding" }
    }
  }
}
