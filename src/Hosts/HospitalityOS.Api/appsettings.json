{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bindings": {
    "IdGenerator": {
      "Default": { "Adapter": "GuidV7" }
    },
    "EventTransport": {
      "Default": { "Adapter": "InMemory" }
    }
  },
  "Persistence": {
    "Provider": "InMemory"
  }
}
