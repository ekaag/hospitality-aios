<Project>
  <!-- Central package management: the only place package versions appear. See solution-structure.md §5. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Hosting -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <!-- Testing -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- xUnit v3 on Microsoft.Testing.Platform (opted in via global.json); no VSTest packages needed. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
