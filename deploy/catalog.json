{
  "$comment": "Every resource the product needs, by its job (the purpose), and the service each cloud offers for it. A deployment plan (plans/) chooses a cloud and region per resource; the orchestrator (tooling/) deploys a cloud's service through its module. A service without a module is known but not yet deployable; a resource marked planned is not yet needed by the app, so plans may leave it out.",
  "product": "hospitalityos",
  "$environments": "dev, test, and prod (test rather than staging: secrets-staging-uksouth-kv would be 26 characters, over Key Vault's 24). Outside dev, services take their smallest paid tier, since a subscription has only one free AI Search service and one free SignalR unit. prod alone protects its stateful resources.",
  "environments": ["dev", "test", "prod"],
  "clouds": {
    "azure": { "tool": "bicep", "status": "available" },
    "aws": { "tool": "cloudformation", "status": "planned" },
    "gcp": { "tool": null, "status": "undecided", "note": "Deployment Manager is retired and Infrastructure Manager runs Terraform; to be agreed when a plan first uses GCP." }
  },
  "resources": {
    "logs": {
      "job": "Logs and metrics from every resource.",
      "group": "platform",
      "dependsOn": [],
      "services": {
        "azure": { "service": "Log Analytics workspace", "type": "log", "module": "azure/modules/logs.bicep" },
        "aws": { "service": "CloudWatch Logs" },
        "gcp": { "service": "Cloud Logging" }
      }
    },
    "telemetry": {
      "job": "Traces, metrics, and logs from the app (OpenTelemetry), searchable alongside the logs workspace.",
      "group": "platform",
      "dependsOn": ["logs", "identity-api"],
      "services": {
        "azure": {
          "service": "Application Insights",
          "type": "appi",
          "module": "azure/modules/telemetry.bicep",
          "inputs": { "workspaceId": "logs.workspaceId", "principalId": "identity-api.principalId" },
          "appSettings": {
            "Telemetry__Exporter": "AzureMonitor",
            "Telemetry__AzureMonitor__ConnectionString": "${telemetry.connectionString}"
          }
        },
        "aws": { "service": "CloudWatch (OpenTelemetry)" },
        "gcp": { "service": "Cloud Trace and Cloud Monitoring" }
      }
    },
    "identity-api": {
      "job": "The API's own identity, which the resources it uses trust; no stored credentials.",
      "group": "platform",
      "dependsOn": [],
      "services": {
        "azure": { "service": "User-assigned managed identity", "type": "id", "module": "azure/modules/identity-api.bicep" },
        "aws": { "service": "IAM role" },
        "gcp": { "service": "Service account" }
      }
    },
    "identity-data": {
      "job": "The database's administrator, which only the migration step signs in as, to change the schema and grant the API its tables.",
      "group": "platform",
      "dependsOn": [],
      "services": {
        "azure": { "service": "User-assigned managed identity", "type": "id", "module": "azure/modules/identity-data.bicep" },
        "aws": { "service": "IAM role" },
        "gcp": { "service": "Service account" }
      }
    },
    "images": {
      "job": "The registry the app's container images are pushed to and pulled from.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Container registry",
          "type": "acr",
          "compact": true,
          "maxLength": 50,
          "module": "azure/modules/images.bicep",
          "inputs": { "pullPrincipalId": "identity-api.principalId" }
        },
        "aws": { "service": "ECR" },
        "gcp": { "service": "Artifact Registry" }
      }
    },
    "secrets": {
      "job": "Secrets the app reads at run time, by reference.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "stateful": true,
      "services": {
        "azure": {
          "service": "Key Vault",
          "type": "kv",
          "maxLength": 24,
          "module": "azure/modules/secrets.bicep",
          "inputs": { "readerPrincipalId": "identity-api.principalId" },
          "secureInputs": { "anthropicApiKey": "ANTHROPIC_API_KEY" },
          "appSettings": {
            "Bindings__SecretStore__Default__Adapter": "AzureKeyVault",
            "Bindings__SecretStore__Default__Settings__VaultUri": "${secrets.vaultUri}",
            "Bindings__SigningKey__Default__Adapter": "AzureKeyVault",
            "Bindings__SigningKey__Default__Settings__VaultUri": "${secrets.vaultUri}",
            "Bindings__SigningKey__Default__Settings__KeyName": "${secrets.signingKeyName}"
          }
        },
        "aws": { "service": "Secrets Manager" },
        "gcp": { "service": "Secret Manager" }
      }
    },
    "apps": {
      "job": "Where the app's containers run, shared by its hosts.",
      "group": "platform",
      "dependsOn": ["logs"],
      "services": {
        "azure": {
          "service": "Container Apps environment",
          "type": "cae",
          "module": "azure/modules/apps.bicep",
          "inputs": { "logsWorkspaceId": "logs.workspaceId" }
        },
        "aws": { "service": "ECS cluster" },
        "gcp": { "service": "Cloud Run (regional; no environment resource)" }
      }
    },
    "signin": {
      "job": "Staff sign-in (K4b): the API's and the staff apps' registrations, their consent, the Operator role, and the sign-up and sign-in user flow, in the environment's Microsoft Entra External ID tenant (created by bootstrap-signin). Who a sign-in acts as is kept by the app (StaffAccess), so it holds no data of its own.",
      "group": "identity",
      "dependsOn": [],
      "services": {
        "azure": {
          "service": "Microsoft Entra External ID",
          "type": "ciam",
          "driver": "graph",
          "module": "azure/signin/apps.json",
          "appSettings": {
            "Authentication__Schemes__StaffSignIn__Authority": "${signin.authority}",
            "Authentication__Schemes__StaffSignIn__Audience": "${signin.apiClientId}",
            "Authentication__Schemes__StaffSignIn__ValidIssuer": "${signin.issuer}"
          }
        },
        "aws": { "service": "Amazon Cognito" },
        "gcp": { "service": "Identity Platform" }
      }
    },
    "api": {
      "job": "The API host (src/Hosts/HospitalityOS.Api), serving guests, staff, and administrators.",
      "group": "api",
      "dependsOn": ["apps", "images", "identity-api", "secrets", "events", "blobs", "search-content", "realtime", "signin", "inference-chat", "inference-embed", "telemetry", "data", "migrate"],
      "image": { "project": "src/Hosts/HospitalityOS.Api", "repository": "hospitalityos-api", "registry": "images" },
      "services": {
        "azure": {
          "service": "Container app",
          "type": "ca",
          "maxLength": 32,
          "module": "azure/modules/api.bicep",
          "inputs": {
            "environmentId": "apps.environmentId",
            "registryServer": "images.loginServer",
            "identityId": "identity-api.identityId",
            "identityClientId": "identity-api.clientId"
          }
        },
        "aws": { "service": "ECS Fargate service" },
        "gcp": { "service": "Cloud Run service" }
      }
    },
    "data": {
      "job": "The relational database, PostgreSQL on every cloud (the app adapter is EfCore.PostgreSql): records, outbox and inbox, audit (IUnitOfWork and repositories). Its schema comes from the migration step (migrate); the API signs in as its own identity.",
      "group": "api",
      "stateful": true,
      "dependsOn": ["identity-api", "identity-data"],
      "services": {
        "azure": {
          "service": "Azure Database for PostgreSQL flexible server",
          "type": "psql",
          "maxLength": 63,
          "module": "azure/modules/data.bicep",
          "inputs": { "adminPrincipalId": "identity-data.principalId", "adminName": "identity-data.name" },
          "parameters": {
            "sku": { "dev": "Standard_B1ms", "test": "Standard_B1ms", "prod": "Standard_B1ms" },
            "tier": { "dev": "Burstable", "test": "Burstable", "prod": "Burstable" }
          },
          "appSettings": {
            "Persistence__Provider": "PostgreSql",
            "Persistence__SignIn": "Entra",
            "Persistence__ConnectionString": "Host=${data.host};Database=${data.database};Username=${identity-api.name};Ssl Mode=Require"
          }
        },
        "aws": { "service": "RDS for PostgreSQL" },
        "gcp": { "service": "Cloud SQL for PostgreSQL" }
      }
    },
    "migrate": {
      "job": "The deployment's migration step: the API image in its migrate mode, run to completion before each API deployment. It applies the schema, grants the API's identity its tables, and seeds where the environment asks; every step is idempotent.",
      "group": "api",
      "dependsOn": ["apps", "images", "identity-api", "identity-data", "data", "secrets", "events", "blobs", "search-content", "realtime", "signin", "inference-chat", "inference-embed"],
      "image": { "project": "src/Hosts/HospitalityOS.Api", "repository": "hospitalityos-api", "registry": "images" },
      "services": {
        "azure": {
          "service": "Container Apps job",
          "type": "caj",
          "maxLength": 32,
          "module": "azure/modules/migrate.bicep",
          "run": true,
          "inputs": {
            "environmentId": "apps.environmentId",
            "registryServer": "images.loginServer",
            "pullIdentityId": "identity-api.identityId",
            "identityId": "identity-data.identityId",
            "identityClientId": "identity-data.clientId",
            "identityName": "identity-data.name",
            "appRoleName": "identity-api.name",
            "appRoleObjectId": "identity-api.principalId",
            "dataHost": "data.host",
            "database": "data.database"
          },
          "parameters": { "seed": { "dev": true, "test": true, "prod": false } }
        },
        "aws": { "service": "ECS task" },
        "gcp": { "service": "Cloud Run job" }
      }
    },
    "events": {
      "job": "Events between parts of the app and scheduled deliveries (IEventTransport, IScheduler): one topic with a subscription per event handler, and a queue for scheduled work, as events.json lists them.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Service Bus",
          "type": "sbns",
          "maxLength": 50,
          "module": "azure/modules/events.bicep",
          "inputs": { "principalId": "identity-api.principalId" },
          "appSettings": {
            "Bindings__EventTransport__Default__Adapter": "AzureServiceBus",
            "Bindings__EventTransport__Default__Settings__Namespace": "${events.namespaceHost}",
            "Bindings__EventTransport__Default__Settings__Topic": "${events.topic}",
            "Bindings__EventTransport__Default__Settings__MaxDeliveryCount": "${events.maxDeliveryCount}",
            "Bindings__Scheduler__Default__Adapter": "AzureServiceBus",
            "Bindings__Scheduler__Default__Settings__Namespace": "${events.namespaceHost}",
            "Bindings__Scheduler__Default__Settings__Queue": "${events.queue}"
          }
        },
        "aws": { "service": "SQS + SNS + EventBridge Scheduler" },
        "gcp": { "service": "Pub/Sub + Cloud Tasks" }
      }
    },
    "blobs": {
      "job": "Files the app keeps (IBlobStore): evidence photos staff complete work with, later content assets.",
      "group": "platform",
      "stateful": true,
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Blob Storage",
          "type": "st",
          "compact": true,
          "maxLength": 24,
          "module": "azure/modules/blobs.bicep",
          "inputs": { "principalId": "identity-api.principalId" },
          "appSettings": {
            "Bindings__BlobStore__Default__Adapter": "AzureBlobStorage",
            "Bindings__BlobStore__Default__Settings__ServiceUri": "${blobs.serviceUri}",
            "Bindings__BlobStore__Default__Settings__Container": "${blobs.container}"
          }
        },
        "aws": { "service": "S3" },
        "gcp": { "service": "Cloud Storage" }
      }
    },
    "config": {
      "job": "Feature flags per property (IFeatureFlags), added when a feature first needs a toggle.",
      "group": "platform",
      "planned": "later",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": { "service": "App Configuration" },
        "aws": { "service": "AppConfig" },
        "gcp": { "service": "Parameter Manager" }
      }
    },
    "search-content": {
      "job": "Search over the property's content and its vectors (ISearchIndex, IVectorStore). Its indexes are rebuilt from the content, so it holds nothing of its own.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Azure AI Search",
          "type": "srch",
          "maxLength": 60,
          "module": "azure/modules/search-content.bicep",
          "inputs": { "principalId": "identity-api.principalId", "deployerPrincipalId": "deployer.principalId" },
          "parameters": { "sku": { "dev": "free", "test": "basic", "prod": "basic" } },
          "indexes": ["azure/search/content.json", "azure/search/content-vectors.json"],
          "appSettings": {
            "Bindings__SearchIndex__Default__Adapter": "AzureAISearch",
            "Bindings__SearchIndex__Default__Settings__Endpoint": "${search-content.endpoint}",
            "Bindings__VectorStore__Default__Adapter": "AzureAISearch",
            "Bindings__VectorStore__Default__Settings__Endpoint": "${search-content.endpoint}"
          }
        },
        "aws": { "service": "OpenSearch Service" },
        "gcp": { "service": "Vertex AI Search" }
      }
    },
    "realtime": {
      "job": "Live updates to browsers (IRealtimeNotifier): carries the API hub's connections, so every replica reaches every client.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Azure SignalR Service",
          "type": "sigr",
          "maxLength": 63,
          "module": "azure/modules/realtime.bicep",
          "inputs": { "principalId": "identity-api.principalId" },
          "parameters": { "sku": { "dev": "Free_F1", "test": "Standard_S1", "prod": "Standard_S1" } },
          "appSettings": {
            "Bindings__RealtimeNotifier__Default__Adapter": "AzureSignalR",
            "Bindings__RealtimeNotifier__Default__Settings__Endpoint": "${realtime.endpoint}"
          }
        },
        "aws": { "service": "API Gateway WebSockets" },
        "gcp": { "service": "None managed; the in-process adapter on Cloud Run" }
      }
    },
    "inference-chat": {
      "job": "Chat, classification, extraction, and judging models (IChatModel, IClassifier, IStructuredExtractor, IEvaluationJudge). The AI tasks use Claude (the anthropic provider, its key in the secrets vault) with these models as the fallback, or these models alone when no Anthropic key is set.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Azure OpenAI in Microsoft Foundry",
          "type": "oai",
          "maxLength": 64,
          "module": "azure/modules/inference-chat.bicep",
          "inputs": { "principalId": "identity-api.principalId", "deployerPrincipalId": "deployer.principalId" },
          "parameters": { "capacity": { "dev": 50, "test": 50, "prod": 100 } },
          "appSettings": {
            "Inference__Providers__azure-chat__Adapter": "AzureOpenAI",
            "Inference__Providers__azure-chat__Settings__Endpoint": "${inference-chat.endpoint}",
            "Inference__Tasks__concierge.answer__Provider": "azure-chat",
            "Inference__Tasks__concierge.answer__Model": "${inference-chat.chatDeployment}",
            "Inference__Tasks__intent.classify__Provider": "azure-chat",
            "Inference__Tasks__intent.classify__Model": "${inference-chat.chatDeployment}",
            "Inference__Tasks__guestservice.extract__Provider": "azure-chat",
            "Inference__Tasks__guestservice.extract__Model": "${inference-chat.chatDeployment}"
          },
          "appSettingsWhen": {
            "secrets.anthropicKeySet": {
              "Inference__Tasks__concierge.answer__Provider": "anthropic",
              "Inference__Tasks__concierge.answer__Model": "claude-sonnet-5-5",
              "Inference__Tasks__concierge.answer__Fallback__0": "azure-chat:${inference-chat.chatDeployment}",
              "Inference__Tasks__intent.classify__Provider": "anthropic",
              "Inference__Tasks__intent.classify__Model": "claude-haiku-5-5",
              "Inference__Tasks__intent.classify__Fallback__0": "azure-chat:${inference-chat.chatDeployment}",
              "Inference__Tasks__guestservice.extract__Provider": "anthropic",
              "Inference__Tasks__guestservice.extract__Model": "claude-haiku-5-5",
              "Inference__Tasks__guestservice.extract__Fallback__0": "azure-chat:${inference-chat.chatDeployment}"
            }
          }
        },
        "aws": { "service": "Bedrock" },
        "gcp": { "service": "Vertex AI" }
      }
    },
    "inference-embed": {
      "job": "Embedding models for content search (IEmbeddingModel). Its vectors' width is the content-vectors index's.",
      "group": "platform",
      "dependsOn": ["identity-api"],
      "services": {
        "azure": {
          "service": "Azure OpenAI in Microsoft Foundry",
          "type": "oai",
          "maxLength": 64,
          "module": "azure/modules/inference-embed.bicep",
          "inputs": { "principalId": "identity-api.principalId", "deployerPrincipalId": "deployer.principalId" },
          "parameters": { "capacity": { "dev": 50, "test": 50, "prod": 100 } },
          "appSettings": {
            "Inference__Providers__azure-embed__Adapter": "AzureOpenAI",
            "Inference__Providers__azure-embed__Settings__Endpoint": "${inference-embed.endpoint}",
            "Inference__Tasks__content.embed__Provider": "azure-embed",
            "Inference__Tasks__content.embed__Model": "${inference-embed.embeddingDeployment}"
          }
        },
        "aws": { "service": "Bedrock" },
        "gcp": { "service": "Vertex AI" }
      }
    },
    "web-guest": {
      "job": "The guest web app (apps/guest-web).",
      "group": "web",
      "planned": "later",
      "dependsOn": ["api"],
      "services": {
        "azure": { "service": "Static Web Apps" },
        "aws": { "service": "S3 + CloudFront" },
        "gcp": { "service": "Cloud Storage + Cloud CDN" }
      }
    },
    "web-staff": {
      "job": "The staff web app (apps/staff-web).",
      "group": "web",
      "planned": "later",
      "dependsOn": ["api"],
      "services": {
        "azure": { "service": "Static Web Apps" },
        "aws": { "service": "S3 + CloudFront" },
        "gcp": { "service": "Cloud Storage + Cloud CDN" }
      }
    },
    "web-admin": {
      "job": "The admin web app (apps/admin-web).",
      "group": "web",
      "planned": "later",
      "dependsOn": ["api"],
      "services": {
        "azure": { "service": "Static Web Apps" },
        "aws": { "service": "S3 + CloudFront" },
        "gcp": { "service": "Cloud Storage + Cloud CDN" }
      }
    }
  }
}
