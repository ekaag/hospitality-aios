{
  "$comment": "The event infrastructure, whichever cloud hosts it: one topic every event is published to, one subscription per event handler (each gets every event), and one queue for scheduled work. The cloud transports may not create these, so a new handler needs its subscription here; an integration test (EventInfrastructureTests) keeps the list equal to the API's handlers. maxDeliveryCount is the deliveries before an event is dead-lettered, given to both the broker and the app.",
  "topic": "events",
  "queue": "scheduled",
  "maxDeliveryCount": 5,
  "subscriptions": [
    "Content.IndexOnContentItemCreated",
    "Content.IndexOnContentItemUpdated",
    "concierge.answer",
    "guestservice.extract",
    "guestservice.notify_completion",
    "guestservice.on_work_cancelled",
    "guestservice.on_work_completed",
    "guestservice.on_work_expired",
    "guestservice.on_work_failed",
    "guestservice.on_work_started",
    "guestservice.request_work",
    "guestsurface.on_message_received",
    "guestsurface.on_message_sent",
    "guestsurface.on_request_completed",
    "guestsurface.on_request_created",
    "guestsurface.on_request_updated",
    "humanaction.reroute_on_duty",
    "humanaction.route",
    "humanaction.route_to_new_staff",
    "humanaction.watch_acceptance",
    "intent.classify",
    "staffsurface.on_work_accepted",
    "staffsurface.on_work_assigned",
    "staffsurface.on_work_cancelled",
    "staffsurface.on_work_completed",
    "staffsurface.on_work_expired",
    "staffsurface.on_work_failed",
    "staffsurface.on_work_requested",
    "staffsurface.on_work_started"
  ]
}
