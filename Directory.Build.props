<Project>
  <!-- Shared build settings for every project. See solution-structure.md §5. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML docs. Required (as an error) only on public ports and contracts (coding-standards.md §3). -->
    <RequireXmlDocs Condition="$(MSBuildProjectName.StartsWith('HospitalityOS.Ports')) Or '$(MSBuildProjectName)' == 'HospitalityOS.Contracts' Or '$(MSBuildProjectName)' == 'HospitalityOS.IntegrationContracts'">true</RequireXmlDocs>
    <NoWarn Condition="'$(RequireXmlDocs)' != 'true'">$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- Versioned prompts (P6, slice G3): Prompts/{name}/v{number}.md and the lock file Prompts/prompts.lock.json are
       embedded under fixed names that HospitalityOS.Bindings' prompt registry reads (AddPrompts). -->
  <ItemGroup>
    <EmbeddedResource Include="Prompts/**/*.md" LogicalName="HospitalityOS.Prompts/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Prompts/prompts.lock.json" LogicalName="HospitalityOS.Prompts/prompts.lock.json" Condition="Exists('$(MSBuildProjectDirectory)/Prompts/prompts.lock.json')" />
  </ItemGroup>
</Project>
